# Port for the local web server
PORT=3000

# How often (ms) to refresh Singapore Pools' open-match list
SGPOOLS_POLL_MS=60000

# Serverless only (Vercel): how stale (ms) the in-memory cache can get
# before a request triggers an on-demand refresh instead of serving it.
CACHE_TTL_MS=60000

# src/app.js reads the pre-built scrape snapshot published by the GitHub
# Actions job (.github/workflows/snapshot.yml) — by default from the GitHub
# contents API for the repo/branch below, with raw.githubusercontent.com as
# fallback. Point SNAPSHOT_REPO/BRANCH at a fork, or SNAPSHOT_URL at a
# fully custom location. SNAPSHOT_MAX_AGE_MS is how old the snapshot may be
# before requests fall back to an on-demand scrape.
# SNAPSHOT_REPO=alvinkohsk-gh/sports
# SNAPSHOT_BRANCH=data-snapshot
# SNAPSHOT_URL=
SNAPSHOT_MAX_AGE_MS=2700000

# Snapshot job only: a FlareSolverr endpoint to route Cloudflare-blocked
# tipster pages through (see .github/workflows/snapshot.yml). Unset locally
# and on Vercel — those fall back to the headless browser instead.
# FLARESOLVERR_URL=http://localhost:8191/v1
# TIPSTERS_DEADLINE_MS=25000
# SPORTSMOLE_MAX_ARTICLES=40

# Set to "true" to run entirely on bundled sample data (data/*.json) instead
# of hitting the live sites. Useful for developing/testing the UI offline
# or in a sandboxed environment with no outbound network access.
MOCK_MODE=false

# Set to "true" to get verbose console logs from the Singapore Pools scraper
# and have it save the raw HTML it fetched to debug-sgpools-raw.html, so you
# can see exactly what it saw if it's not finding fixtures.
SGPOOLS_DEBUG=false

# Set to "true" to save each tipster site's fetched HTML to
# debug-tipsters/<site>.html, useful when a site's selectors stop matching.
TIPSTERS_DEBUG=false
