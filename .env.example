# Port for the local web server
PORT=3000

# How often (ms) to refresh Singapore Pools' open-match list
SGPOOLS_POLL_MS=60000

# Set to "true" to run entirely on bundled sample data (data/*.json) instead
# of hitting the live sites. Useful for developing/testing the UI offline
# or in a sandboxed environment with no outbound network access.
MOCK_MODE=false

# Set to "true" to get verbose console logs from the Singapore Pools scraper
# and have it save the raw HTML it fetched to debug-sgpools-raw.html, so you
# can see exactly what it saw if it's not finding fixtures.
SGPOOLS_DEBUG=false

# Set to "true" to save each tipster site's fetched HTML to
# debug-tipsters/<site>.html, useful when a site's selectors stop matching.
TIPSTERS_DEBUG=false
